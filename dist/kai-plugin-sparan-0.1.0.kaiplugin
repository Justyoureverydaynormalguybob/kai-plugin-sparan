ssion.\n\nTHIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS\n\"AS IS\" AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT\nLIMITED TO, THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR\nA PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT\nOWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL,\nSPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT\nLIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE,\nDATA, OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY\nTHEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT\n(INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE\nOF THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n\n---\n\nCode generated by the command line utilities is owned by the owner\nof the input file used when generating it. This code is not\nstandalone and requires a support library to be linked with it. This\nsupport library is itself covered by the above license.\n\n","style.css":":root {\n  color-scheme: light dark;\n  --bg: #f7f6f2; --card: #ffffff; --ink: #1d1d1b; --ink2: #55524b; --rule: #e3e0d8;\n  --accent: #2f5d50; --accent-ink: #ffffff; --warn: #8a5a00; --warn-bg: #fff6e0; --bad: #a33a2a; --good: #2f6d3a;\n  --mono: ui-monospace, \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace;\n}\n@media (prefers-color-scheme: dark) {\n  :root { --bg: #151614; --card: #1f201d; --ink: #ecebe6; --ink2: #aaa79e; --rule: #33342f; --accent: #6fb39d; --accent-ink: #0f1a16; --warn: #f0c060; --warn-bg: #2b2414; --bad: #ef8a78; --good: #8fd39a; }\n}\n* { box-sizing: border-box; }\nbody { margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.5 system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif; }\nmain { max-width: 760px; margin: 0 auto; padding: 20px 16px 48px; }\nh1 { font-size: 26px; margin: 0; }\nh2 { font-size: 17px; margin: 0 0 8px; }\np { margin: 0 0 10px; }\n.top { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; margin-bottom: 16px; }\n.top > * { min-width: 0; }\n.top-right { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }\n.lede { color: var(--ink2); margin: 4px 0 0; }\n.net { display: flex; gap: 6px; align-items: center; font-size: 13px; color: var(--ink2); }\n.card { background: var(--card); border: 1px solid var(--rule); border-radius: 10px; padding: 16px; margin-bottom: 14px; }\n.row { display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap; }\n.grow { flex: 1; min-width: 0; }\n.row-buttons { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 8px; }\n.label { font-size: 12px; text-transform: uppercase; letter-spacing: .05em; color: var(--ink2); }\n.address { font-family: var(--mono); font-size: 14px; word-break: break-all; }\n.stats { display: flex; gap: 28px; align-items: flex-end; margin-top: 14px; flex-wrap: wrap; }\n.big { font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; }\n.hint { color: var(--ink2); font-size: 13px; }\n.small-print { margin-top: 12px; font-size: 12px; word-break: break-all; }\n.warn { background: var(--warn-bg); color: var(--warn); padding: 10px 12px; border-radius: 8px; }\n.error { background: var(--warn-bg); color: var(--bad); padding: 10px 12px; border-radius: 8px; border: 1px solid var(--bad); }\n.notice { background: var(--warn-bg); color: var(--warn); padding: 10px 12px; border-radius: 8px; }\n.progress { font-size: 14px; color: var(--ink2); margin-top: 10px; word-break: break-word; }\nbutton, select, input, textarea { font: inherit; color: inherit; }\nbutton { border: 1px solid var(--rule); background: var(--card); border-radius: 8px; padding: 7px 14px; cursor: pointer; }\nbutton:hover { border-color: var(--ink2); }\nbutton:disabled { opacity: .55; cursor: default; }\nbutton.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }\nbutton.danger { color: var(--bad); border-color: var(--bad); }\nbutton.small { padding: 4px 10px; font-size: 13px; }\nselect, input, textarea { background: var(--bg); border: 1px solid var(--rule); border-radius: 8px; padding: 7px 10px; max-width: 100%; }\ntextarea { width: 100%; font-family: var(--mono); }\n.field { display: flex; flex-direction: column; gap: 4px; margin: 10px 0; }\n.field input { font-family: var(--mono); }\n.check { display: flex; gap: 8px; align-items: center; }\n.pill { font-size: 12px; padding: 3px 10px; border-radius: 999px; border: 1px solid var(--rule); color: var(--ink2); white-space: nowrap; }\n.pill.on { color: var(--good); border-color: var(--good); }\n.pill.off { color: var(--warn); border-color: var(--warn); }\n.words { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 6px 14px; padding-left: 28px; font-family: var(--mono); margin: 12px 0; }\n.check-fields { display: flex; gap: 10px; flex-wrap: wrap; }\n.check-fields label { display: flex; flex-direction: column; gap: 4px; font-size: 13px; }\n.history { list-style: none; padding: 0; margin: 0; }\n.history li { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-top: 1px solid var(--rule); flex-wrap: wrap; }\n.history li:first-child { border-top: 0; }\n.history .amt { font-variant-numeric: tabular-nums; font-weight: 600; }\n.history .in { color: var(--good); }\n.history .meta { color: var(--ink2); font-size: 13px; }\n.history button { padding: 2px 8px; font-size: 12px; }\n"},"publicKey":"MCowBQYDK2VwAyEAGSgBWXfohza4Rkm9Mkg3yfqMHWVXojy5fOcV2KVIAGI=","signature":"ivvFg5t9p+9zsem5cB6gvIOKwDxAriJ6FfrdrJV1caJNiOPYZwqDX7fNtcl5twbwboM3aScz3o7qF0oDmgUACA=="}