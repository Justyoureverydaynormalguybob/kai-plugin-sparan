{"manifest":{"schema":2,"apiVersion":3,"id":"community.sparan","version":"0.1.0","name":"Sparán","description":"A post-quantum Koinos wallet. Your account answers only to an ML-DSA-44 (NIST FIPS 204) key, kept encrypted by your operating system. Every send is approved by you in KAI.","entry":"index.html","runtime":"native","service":"service/index.js","permissions":["native.execute","storage.read","storage.write","network.status","network.fetch","secrets.use","desktop.external","services.provide"],"provides":["koinos.pq-wallet"],"consumes":[]},"files":{"app.js":"\"use strict\";\n// Sparán window. Everything the wallet does happens in the native service (service/index.js);\n// this page only shows state and passes the user's choices on. Text from the chain, addresses\n// and recovery words go in with textContent, never as HTML.\n(function () {\n  const I = window.SparanI18n;\n  const t = (k, p) => I.t(k, p);\n  const $ = (id) => document.getElementById(id);\n  const call = (method, input) => window.kai.call(method, input || {});\n  let state = null, busy = false, words = null, checkIdx = [], pollTimer = null, sendPoll = null, lastSend = null;\n\n  function show(id, on) { $(id).hidden = !on; }\n  function showError(message) { $(\"error\").hidden = !message; $(\"error\").textContent = message || \"\"; }\n  function errText(e) { return (e && e.message ? e.message : String(e)).replace(/^Error invoking remote method '[^']*': (Error: )?/, \"\"); }\n\n  async function act(fn) {\n    if (busy) return;\n    busy = true;\n    for (const b of document.querySelectorAll(\"button\")) b.disabled = true;\n    try { showError(\"\"); await fn(); }\n    catch (e) { showError(errText(e)); }\n    finally {\n      busy = false;\n      for (const b of document.querySelectorAll(\"button\")) b.disabled = false;\n      await refresh();\n    }\n  }\n\n  function pill(kind) {\n    const p = $(\"pill\");\n    p.className = \"pill\" + (kind === \"pillActive\" ? \" on\" : kind === \"pillNotActive\" || kind === \"pillLocal\" ? \" off\" : \"\");\n    p.textContent = t(kind);\n  }\n\n  async function refresh() {\n    try { state = await call(\"state\"); } catch (e) { showError(errText(e)); return; }\n    $(\"network\").value = state.network;\n    $(\"share\").checked = !!state.shareWithPlugins;\n    $(\"about\").textContent = t(\"about\", { sha: state.pqwalletWasmSha256 });\n    const notices = [];\n    if (state.localOnly) notices.push(t(\"localOnly\"));\n    if (state.network === \"testnet\") notices.push(t(\"testnetNote\"));\n    $(\"notice\").hidden = !notices.length;\n    $(\"notice\").textContent = notices.join(\" \");\n\n    const creating = !$(\"words-card\").hidden || !$(\"restore-card\").hidden;\n    if (!state.hasWallet) {\n      pill(\"pillNoWallet\");\n      show(\"setup\", !creating && state.secureStorage);\n      for (const id of [\"wallet\", \"activate\", \"send\", \"history-card\", \"settings\"]) show(id, false);\n      if (!state.secureStorage) showError(t(\"noSecure\"));\n      return;\n    }\n    show(\"setup\", false);\n    show(\"wallet\", true);\n    show(\"settings\", true);\n    $(\"address\").textContent = state.address;\n    if (state.localOnly) {\n      pill(\"pillLocal\");\n      for (const id of [\"activate\", \"send\", \"history-card\"]) show(id, false);\n      $(\"koin\").textContent = \"—\"; $(\"mana\").textContent = \"—\";\n      return;\n    }\n    await loadChain();\n  }\n\n  async function loadChain() {\n    pill(\"pillChecking\");\n    try {\n      const [b, a] = await Promise.all([call(\"balances\"), call(\"activation.info\")]);\n      $(\"koin\").textContent = b.koin;\n      $(\"mana\").textContent = b.mana;\n      const running = state.activation && !state.activation.done;\n      show(\"activate\", !a.active || running || (state.activation && state.activation.done));\n      show(\"send\", a.active);\n      pill(a.active ? \"pillActive\" : \"pillNotActive\");\n      $(\"activate-need\").textContent = a.enoughMana ? t(\"needOk\", { have: a.mana, need: a.requiredMana }) : t(\"needLine\", { have: a.mana, need: a.requiredMana });\n      $(\"activate-need\").hidden = a.active;\n      $(\"btn-activate\").hidden = a.active || running;\n      $(\"btn-activate\").disabled = !a.enoughMana;\n      renderActivation(a.active);\n      await loadHistory();\n    } catch (e) {\n      pill(\"pillNotActive\");\n      showError(errText(e));\n    }\n  }\n\n  function renderActivation(active) {\n    const s = state.activation;\n    const el = $(\"activate-progress\");\n    if (!s) { el.hidden = true; return; }\n    el.hidden = false;\n    if (s.error) el.textContent = t(\"activationFailed\", { error: s.error });\n    else if (s.done || active) el.textContent = t(\"activated\");\n    else el.textContent = t(\"activating\", { message: s.message || \"\" }) + (s.txId ? ` (${s.txId})` : \"\");\n    clearTimeout(pollTimer);\n    if (!s.done) pollTimer = setTimeout(refresh, 5000);\n  }\n\n  async function loadHistory() {\n    const list = $(\"history\");\n    show(\"history-card\", true);\n    let items = [];\n    try { items = (await call(\"history\", { limit: 20 })).items || []; } catch (e) { items = []; }\n    list.textContent = \"\";\n    if (!items.length) {\n      const li = document.createElement(\"li\");\n      li.className = \"meta\";\n      li.textContent = t(\"noHistory\");\n      list.appendChild(li);\n      return;\n    }\n    for (const it of items) {\n      const li = document.createElement(\"li\");\n      const left = document.createElement(\"span\");\n      const amt = document.createElement(\"span\");\n      amt.className = \"amt\" + (it.direction === \"in\" ? \" in\" : \"\");\n      const unit = it.isKoin ? \" KOIN\" : \"\";\n      const who = it.counterparty ? `${it.counterparty.slice(0, 6)}…${it.counterparty.slice(-4)}` : \"?\";\n      amt.textContent = it.direction === \"in\" ? t(\"received\", { amt: (it.amount || \"?\") + unit, from: who })\n        : it.direction === \"out\" ? t(\"sentTo\", { amt: (it.amount || \"?\") + unit, to: who }) : t(\"otherActivity\");\n      left.appendChild(amt);\n      if (it.reverted) left.appendChild(document.createTextNode(\" \" + t(\"reverted\")));\n      const meta = document.createElement(\"span\");\n      meta.className = \"meta\";\n      meta.textContent = it.blockHeight ? `#${it.blockHeight} ` : \"\";\n      if (it.txId && it.explorer) {\n        const b = document.createElement(\"button\");\n        b.type = \"button\";\n        b.textContent = t(\"explorer\");\n        b.addEventListener(\"click\", () => act(() => call(\"explorer.open\", { txId: it.txId })));\n        meta.appendChild(b);\n      }\n      li.append(left, meta);\n      list.appendChild(li);\n    }\n  }\n\n  // ----- new wallet -----\n  function pickChecks() {\n    const set = new Set();\n    while (set.size < 3) set.add(Math.floor(Math.random() * 24));\n    return [...set].sort((a, b) => a - b);\n  }\n  function renderWords(list) {\n    const ol = $(\"words\");\n    ol.textContent = \"\";\n    for (const w of list) { const li = document.createElement(\"li\"); li.textContent = w; ol.appendChild(li); }\n  }\n\n  $(\"btn-new\").addEventListener(\"click\", () => act(async () => {\n    words = (await call(\"wallet.generate\")).words;\n    renderWords(words);\n    show(\"words-card\", true); show(\"setup\", false); show(\"check\", false);\n    $(\"btn-written\").hidden = false; $(\"btn-save-new\").hidden = true;\n  }));\n  $(\"btn-written\").addEventListener(\"click\", () => {\n    checkIdx = pickChecks();\n    const box = $(\"check-fields\");\n    box.textContent = \"\";\n    for (const i of checkIdx) {\n      const label = document.createElement(\"label\");\n      const span = document.createElement(\"span\");\n      span.textContent = t(\"wordN\", { n: i + 1 });\n      const input = document.createElement(\"input\");\n      input.type = \"text\"; input.autocomplete = \"off\"; input.spellcheck = false; input.dataset.index = String(i);\n      label.append(span, input);\n      box.appendChild(label);\n    }\n    $(\"words\").textContent = \"\"; // hide the list while they check from paper\n    show(\"check\", true);\n    $(\"btn-written\").hidden = true; $(\"btn-save-new\").hidden = false;\n  });\n  $(\"btn-save-new\").addEventListener(\"click\", () => act(async () => {\n    const checks = [...$(\"check-fields\").querySelectorAll(\"input\")].map((el) => ({ index: Number(el.dataset.index), word: el.value }));\n    await call(\"wallet.confirmGenerated\", { checks });\n    words = null;\n    show(\"words-card\", false);\n  }));\n  $(\"btn-cancel-new\").addEventListener(\"click\", () => { words = null; show(\"words-card\", false); refresh(); });\n\n  // ----- restore -----\n  $(\"btn-restore\").addEventListener(\"click\", () => { show(\"restore-card\", true); show(\"setup\", false); $(\"restore-words\").focus(); });\n  $(\"btn-restore-cancel\").addEventListener(\"click\", () => { $(\"restore-words\").value = \"\"; show(\"restore-card\", false); refresh(); });\n  $(\"btn-restore-go\").addEventListener(\"click\", () => act(async () => {\n    await call(\"wallet.restore\", { words: $(\"restore-words\").value });\n    $(\"restore-words\").value = \"\";\n    show(\"restore-card\", false);\n  }));\n\n  // ----- wallet -----\n  $(\"btn-copy\").addEventListener(\"click\", async () => {\n    try { await navigator.clipboard.writeText(state.address); $(\"btn-copy\").textContent = t(\"copied\"); setTimeout(() => { $(\"btn-copy\").textContent = t(\"copy\"); }, 1500); }\n    catch (e) { showError(errText(e)); }\n  });\n  $(\"btn-explorer-addr\").addEventListener(\"click\", () => act(() => call(\"explorer.open\", { address: true })));\n  $(\"btn-refresh\").addEventListener(\"click\", () => act(async () => {}));\n  $(\"network\").addEventListener(\"change\", () => act(() => call(\"network.set\", { network: $(\"network\").value })));\n  $(\"btn-activate\").addEventListener(\"click\", () => act(() => call(\"activation.start\")));\n\n  // ----- send -----\n  let checkTimer = null;\n  async function checkRecipient() {\n    const to = $(\"to\").value.trim();\n    const note = $(\"to-note\");\n    if (!to) { note.hidden = true; show(\"confirm-new-field\", false); return null; }\n    const r = await call(\"recipient.check\", { to });\n    note.hidden = false;\n    note.className = \"hint\";\n    if (!r.valid) { note.textContent = t(\"toInvalid\"); show(\"confirm-new-field\", false); return r; }\n    if (r.self) { note.textContent = t(\"toSelf\"); show(\"confirm-new-field\", false); return r; }\n    if (r.known) { note.textContent = t(\"toKnown\"); show(\"confirm-new-field\", false); return r; }\n    note.textContent = r.lookalike ? t(\"toLookalike\", { addr: r.lookalike }) + \" \" + t(\"toNew\") : t(\"toNew\");\n    if (r.lookalike) note.className = \"warn\";\n    show(\"confirm-new-field\", true);\n    return r;\n  }\n  $(\"to\").addEventListener(\"input\", () => { clearTimeout(checkTimer); checkTimer = setTimeout(() => checkRecipient().catch(() => {}), 250); });\n  $(\"btn-send\").addEventListener(\"click\", () => act(async () => {\n    const to = $(\"to\").value.trim();\n    const r = await checkRecipient();\n    const confirmNew = r && r.valid && !r.known ? $(\"confirm-new\").value.trim() : undefined;\n    const sent = await call(\"send\", { to, amount: $(\"amount\").value.trim(), confirmNew });\n    lastSend = sent.txId;\n    $(\"amount\").value = \"\"; $(\"confirm-new\").value = \"\";\n    const out = $(\"send-result\");\n    out.hidden = false;\n    out.textContent = t(\"sentWait\", { tx: sent.txId });\n    clearInterval(sendPoll);\n    sendPoll = setInterval(async () => {\n      const s = await call(\"send.status\", { txId: lastSend }).catch(() => null);\n      if (!s || s.status === \"sent\") return;\n      clearInterval(sendPoll);\n      out.textContent = s.status === \"mined\" ? `${sent.txId}: ${t(\"sentMined\", { block: s.block })}` : t(\"sentUnconfirmed\");\n      refresh();\n    }, 4000);\n  }));\n\n  // ----- settings -----\n  $(\"share\").addEventListener(\"change\", () => act(() => call(\"share.set\", { on: $(\"share\").checked })));\n  $(\"btn-reveal\").addEventListener(\"click\", () => act(async () => {\n    const r = await call(\"wallet.reveal\");\n    renderWords(r.words);\n    show(\"words-card\", true); show(\"check\", false);\n    $(\"btn-written\").hidden = true; $(\"btn-save-new\").hidden = true;\n    $(\"btn-cancel-new\").textContent = t(\"hide\");\n  }));\n  $(\"btn-remove\").addEventListener(\"click\", () => act(() => call(\"wallet.remove\")));\n\n  // ----- language: follow KAI's setting -----\n  function applyLanguage(st) {\n    I.set(st && st.language);\n    document.documentElement.lang = I.language;\n    document.documentElement.dir = (st && st.direction) || \"ltr\";\n    I.apply();\n    if (state) refresh();\n  }\n  let revision = 0;\n  const unsubscribe = window.kai.locale && window.kai.locale.onChange ? window.kai.locale.onChange((s) => { revision++; applyLanguage(s); }) : () => {};\n  window.addEventListener(\"pagehide\", () => { unsubscribe(); clearTimeout(pollTimer); clearInterval(sendPoll); words = null; }, { once: true });\n  (async () => {\n    const initial = revision;\n    try {\n      const st = window.kai.locale ? await window.kai.locale.get() : null;\n      if (revision === initial) applyLanguage(st);\n    } catch { applyLanguage(null); }\n    await refresh();\n  })();\n})();\n","i18n.js":"\"use strict\";\n// Bundled, offline interface strings for the five languages KAI Core supports. Core owns the\n// language choice; this file only follows it. Missing keys fall back to English. Addresses,\n// amounts, transaction ids and recovery words are never translated.\n(function () {\n  const en = {\n    lede: \"A post-quantum Koinos wallet. Your account answers only to an ML-DSA-44 key.\",\n    network: \"Network\",\n    pillNoWallet: \"No wallet\", pillNotActive: \"Not activated\", pillActive: \"Post-quantum\", pillLocal: \"Local-Only\", pillChecking: \"Checking…\",\n    setupTitle: \"Set up your wallet\",\n    setupHint: \"The wallet is a 24-word recovery phrase. Sparán keeps it on this computer, encrypted by your operating system. Nobody else has a copy, so write the words down on paper.\",\n    createNew: \"Create a new wallet\", restore: \"Restore from 24 words\",\n    wordsTitle: \"Your recovery words\",\n    wordsWarn: \"Write these 24 words down, in order, on paper. Anyone with them can take your KOIN. If you lose them and this computer, nobody can get it back.\",\n    checkHint: \"To make sure, type these three words from your list:\",\n    wordN: \"Word {n}\",\n    written: \"I've written them down\", saveWallet: \"Save the wallet\", cancel: \"Cancel\", hide: \"Hide\",\n    restoreTitle: \"Restore a wallet\", restoreHint: \"Type or paste the 24 words, separated by spaces.\",\n    address: \"Address\", copy: \"Copy\", copied: \"Copied\", explorer: \"Explorer\", mana: \"Mana\", refresh: \"Refresh\",\n    manaHint: \"Mana pays for transactions. It is not spent KOIN: it refills over 5 days, up to your KOIN balance.\",\n    activateTitle: \"Activate post-quantum protection\",\n    activateHint: \"Until it's activated, this address is an ordinary Koinos address. Activating installs the koinos-pq contract on it and registers your ML-DSA-44 key, in one transaction. After that only that key can move its KOIN.\",\n    needLine: \"Activation needs about {need} KOIN of mana. This wallet has {have}. Send KOIN to the address above first.\",\n    needOk: \"This wallet has {have} KOIN of mana, enough to activate (about {need} needed).\",\n    activate: \"Activate\", activating: \"Activating: {message}\", activated: \"Activated. This address now answers only to your ML-DSA-44 key.\",\n    activationFailed: \"Activation stopped: {error}\",\n    sendTitle: \"Send KOIN\", to: \"To\", amount: \"Amount (KOIN)\", sendBtn: \"Send\",\n    confirmLast6: \"Type the last 6 characters of this new address\",\n    toKnown: \"You've sent to this address before.\",\n    toNew: \"A new address. Check it character by character, then type its last 6 characters below.\",\n    toLookalike: \"Careful: this looks like {addr}, which you've used, but it's a different address.\",\n    toSelf: \"That's this wallet's own address.\", toInvalid: \"Not a valid Koinos address.\",\n    sentWait: \"Sent: {tx}. Waiting for a block…\", sentMined: \"In block {block}.\", sentUnconfirmed: \"Not seen in a block yet. Check the explorer before sending again.\",\n    historyTitle: \"Recent activity\", noHistory: \"Nothing yet.\",\n    received: \"Received {amt} from {from}\", sentTo: \"Sent {amt} to {to}\", otherActivity: \"Other activity\", reverted: \"(reverted)\",\n    settingsTitle: \"Settings\", share: \"Let other KAI plugins use this wallet\",\n    shareHint: \"They can see the address and balance and ask for a payment. You approve every payment yourself, in KAI.\",\n    reveal: \"Show recovery words\", remove: \"Remove wallet from this computer\",\n    localOnly: \"KAI is set to Local-Only, so the wallet can't reach the Koinos network. Your key is safe on this computer; change privacy in KAI to use it.\",\n    noSecure: \"This computer can't encrypt a wallet key properly, so Sparán won't hold one here.\",\n    about: \"Signatures: ML-DSA-44 (NIST FIPS 204). Account contract: koinos-pq pqwallet, sha256 {sha}.\",\n    testnetNote: \"Testnet (Harbinger): test KOIN only. The same words give the same address on both networks.\",\n  };\n  const es = {\n    lede: \"Un monedero de Koinos poscuántico. Tu cuenta solo responde a una clave ML-DSA-44.\",\n    network: \"Red\",\n    pillNoWallet: \"Sin monedero\", pillNotActive: \"Sin activar\", pillActive: \"Poscuántico\", pillLocal: \"Solo local\", pillChecking: \"Comprobando…\",\n    setupTitle: \"Configura tu monedero\",\n    setupHint: \"El monedero es una frase de recuperación de 24 palabras. Sparán la guarda en este ordenador, cifrada por tu sistema operativo. Nadie más tiene una copia, así que anota las palabras en papel.\",\n    createNew: \"Crear un monedero nuevo\", restore: \"Restaurar con 24 palabras\",\n    wordsTitle: \"Tus palabras de recuperación\",\n    wordsWarn: \"Anota estas 24 palabras en papel, en orden. Quien las tenga puede llevarse tu KOIN. Si las pierdes junto con este ordenador, nadie podrá recuperarlo.\",\n    checkHint: \"Para asegurarnos, escribe estas tres palabras de tu lista:\",\n    wordN: \"Palabra {n}\",\n    written: \"Ya las he anotado\", saveWallet: \"Guardar el monedero\", cancel: \"Cancelar\", hide: \"Ocultar\",\n    restoreTitle: \"Restaurar un monedero\", restoreHint: \"Escribe o pega las 24 palabras, separadas por espacios.\",\n    address: \"Dirección\", copy: \"Copiar\", copied: \"Copiado\", explorer: \"Explorador\", mana: \"Maná\", refresh: \"Actualizar\",\n    manaHint: \"El maná paga las transacciones. No es KOIN gastado: se recarga en 5 días, hasta tu saldo de KOIN.\",\n    activateTitle: \"Activar la protección poscuántica\",\n    activateHint: \"Hasta que se active, esta es una dirección de Koinos normal. Activarla instala el contrato koinos-pq y registra tu clave ML-DSA-44 en una sola transacción. Después solo esa clave puede mover su KOIN.\",\n    needLine: \"La activación necesita unos {need} KOIN de maná. Este monedero tiene {have}. Envía primero KOIN a la dirección de arriba.\",\n    needOk: \"Este monedero tiene {have} KOIN de maná, suficiente para activarlo (se necesitan unos {need}).\",\n    activate: \"Activar\", activating: \"Activando: {message}\", activated: \"Activado. Esta dirección ya solo responde a tu clave ML-DSA-44.\",\n    activationFailed: \"La activación se detuvo: {error}\",\n    sendTitle: \"Enviar KOIN\", to: \"A\", amount: \"Cantidad (KOIN)\", sendBtn: \"Enviar\",\n    confirmLast6: \"Escribe los últimos 6 caracteres de esta dirección nueva\",\n    toKnown: \"Ya has enviado a esta dirección.\",\n    toNew: \"Una dirección nueva. Revísala carácter a carácter y escribe abajo sus últimos 6 caracteres.\",\n    toLookalike: \"Cuidado: se parece a {addr}, que has usado, pero es otra dirección.\",\n    toSelf: \"Esa es la dirección de este monedero.\", toInvalid: \"No es una dirección de Koinos válida.\",\n    sentWait: \"Enviado: {tx}. Esperando un bloque…\", sentMined: \"En el bloque {block}.\", sentUnconfirmed: \"Aún no aparece en un bloque. Mira el explorador antes de volver a enviar.\",\n    historyTitle: \"Actividad reciente\", noHistory: \"Nada todavía.\",\n    received: \"Recibido {amt} de {from}\", sentTo: \"Enviado {amt} a {to}\", otherActivity: \"Otra actividad\", reverted: \"(revertida)\",\n    settingsTitle: \"Ajustes\", share: \"Dejar que otros plugins de KAI usen este monedero\",\n    shareHint: \"Podrán ver la dirección y el saldo y pedir un pago. Tú apruebas cada pago, en KAI.\",\n    reveal: \"Mostrar palabras de recuperación\", remove: \"Quitar el monedero de este ordenador\",\n    localOnly: \"KAI está en Solo local, así que el monedero no puede conectar con la red Koinos. Tu clave está a salvo en este ordenador; cambia la privacidad en KAI para usarlo.\",\n    noSecure: \"Este ordenador no puede cifrar bien una clave de monedero, así que Sparán no guardará una aquí.\",\n    testnetNote: \"Testnet (Harbinger): solo KOIN de prueba. Las mismas palabras dan la misma dirección en las dos redes.\",\n  };\n  const ptBR = {\n    lede: \"Uma carteira Koinos pós-quântica. Sua conta só responde a uma chave ML-DSA-44.\",\n    network: \"Rede\",\n    pillNoWallet: \"Sem carteira\", pillNotActive: \"Não ativada\", pillActive: \"Pós-quântica\", pillLocal: \"Somente local\", pillChecking: \"Verificando…\",\n    setupTitle: \"Configure sua carteira\",\n    setupHint: \"A carteira é uma frase de recuperação de 24 palavras. O Sparán a guarda neste computador, criptografada pelo seu sistema operacional. Ninguém mais tem cópia, então anote as palavras em papel.\",\n    createNew: \"Criar uma carteira nova\", restore: \"Restaurar com 24 palavras\",\n    wordsTitle: \"Suas palavras de recuperação\",\n    wordsWarn: \"Anote estas 24 palavras em papel, na ordem. Quem as tiver pode levar seu KOIN. Se você perdê-las junto com este computador, ninguém poderá recuperá-lo.\",\n    checkHint: \"Para confirmar, digite estas três palavras da sua lista:\",\n    wordN: \"Palavra {n}\",\n    written: \"Já anotei\", saveWallet: \"Salvar a carteira\", cancel: \"Cancelar\", hide: \"Ocultar\",\n    restoreTitle: \"Restaurar uma carteira\", restoreHint: \"Digite ou cole as 24 palavras, separadas por espaços.\",\n    address: \"Endereço\", copy: \"Copiar\", copied: \"Copiado\", explorer: \"Explorador\", mana: \"Mana\", refresh: \"Atualizar\",\n    manaHint: \"A mana paga as transações. Não é KOIN gasto: ela se recarrega em 5 dias, até o seu saldo de KOIN.\",\n    activateTitle: \"Ativar a proteção pós-quântica\",\n    activateHint: \"Até ser ativado, este é um endereço Koinos comum. Ativar instala o contrato koinos-pq e registra sua chave ML-DSA-44 numa única transação. Depois disso, só essa chave pode mover o KOIN dele.\",\n    needLine: \"A ativação precisa de cerca de {need} KOIN de mana. Esta carteira tem {have}. Envie KOIN para o endereço acima primeiro.\",\n    needOk: \"Esta carteira tem {have} KOIN de mana, o suficiente para ativar (são necessários cerca de {need}).\",\n    activate: \"Ativar\", activating: \"Ativando: {message}\", activated: \"Ativada. Este endereço agora só responde à sua chave ML-DSA-44.\",\n    activationFailed: \"A ativação parou: {error}\",\n    sendTitle: \"Enviar KOIN\", to: \"Para\", amount: \"Valor (KOIN)\", sendBtn: \"Enviar\",\n    confirmLast6: \"Digite os 6 últimos caracteres deste endereço novo\",\n    toKnown: \"Você já enviou para este endereço.\",\n    toNew: \"Um endereço novo. Confira caractere por caractere e digite abaixo os 6 últimos.\",\n    toLookalike: \"Cuidado: parece {addr}, que você usou, mas é outro endereço.\",\n    toSelf: \"Esse é o endereço desta carteira.\", toInvalid: \"Não é um endereço Koinos válido.\",\n    sentWait: \"Enviado: {tx}. Aguardando um bloco…\", sentMined: \"No bloco {block}.\", sentUnconfirmed: \"Ainda não apareceu num bloco. Veja o explorador antes de enviar de novo.\",\n    historyTitle: \"Atividade recente\", noHistory: \"Nada ainda.\",\n    received: \"Recebido {amt} de {from}\", sentTo: \"Enviado {amt} para {to}\", otherActivity: \"Outra atividade\", reverted: \"(revertida)\",\n    settingsTitle: \"Configurações\", share: \"Deixar outros plugins do KAI usarem esta carteira\",\n    shareHint: \"Eles poderão ver o endereço e o saldo e pedir um pagamento. Você aprova cada pagamento, no KAI.\",\n    reveal: \"Mostrar palavras de recuperação\", remove: \"Remover a carteira deste computador\",\n    localOnly: \"O KAI está em Somente local, então a carteira não acessa a rede Koinos. Sua chave está segura neste computador; mude a privacidade no KAI para usá-la.\",\n    noSecure: \"Este computador não consegue criptografar bem uma chave de carteira, então o Sparán não vai guardar uma aqui.\",\n    testnetNote: \"Testnet (Harbinger): só KOIN de teste. As mesmas palavras dão o mesmo endereço nas duas redes.\",\n  };\n  const fr = {\n    lede: \"Un portefeuille Koinos post-quantique. Votre compte ne répond qu'à une clé ML-DSA-44.\",\n    network: \"Réseau\",\n    pillNoWallet: \"Pas de portefeuille\", pillNotActive: \"Non activé\", pillActive: \"Post-quantique\", pillLocal: \"Local uniquement\", pillChecking: \"Vérification…\",\n    setupTitle: \"Configurez votre portefeuille\",\n    setupHint: \"Le portefeuille est une phrase de récupération de 24 mots. Sparán la garde sur cet ordinateur, chiffrée par votre système d'exploitation. Personne d'autre n'en a de copie : notez les mots sur papier.\",\n    createNew: \"Créer un nouveau portefeuille\", restore: \"Restaurer avec 24 mots\",\n    wordsTitle: \"Vos mots de récupération\",\n    wordsWarn: \"Notez ces 24 mots sur papier, dans l'ordre. Quiconque les a peut prendre vos KOIN. Si vous les perdez avec cet ordinateur, personne ne pourra les récupérer.\",\n    checkHint: \"Pour vérifier, tapez ces trois mots de votre liste :\",\n    wordN: \"Mot {n}\",\n    written: \"Je les ai notés\", saveWallet: \"Enregistrer le portefeuille\", cancel: \"Annuler\", hide: \"Masquer\",\n    restoreTitle: \"Restaurer un portefeuille\", restoreHint: \"Tapez ou collez les 24 mots, séparés par des espaces.\",\n    address: \"Adresse\", copy: \"Copier\", copied: \"Copié\", explorer: \"Explorateur\", mana: \"Mana\", refresh: \"Actualiser\",\n    manaHint: \"La mana paie les transactions. Ce ne sont pas des KOIN dépensés : elle se recharge en 5 jours, jusqu'à votre solde de KOIN.\",\n    activateTitle: \"Activer la protection post-quantique\",\n    activateHint: \"Tant qu'elle n'est pas activée, c'est une adresse Koinos ordinaire. L'activation installe le contrat koinos-pq et enregistre votre clé ML-DSA-44 en une seule transaction. Ensuite, seule cette clé peut déplacer ses KOIN.\",\n    needLine: \"L'activation demande environ {need} KOIN de mana. Ce portefeuille en a {have}. Envoyez d'abord des KOIN à l'adresse ci-dessus.\",\n    needOk: \"Ce portefeuille a {have} KOIN de mana, assez pour l'activer (il en faut environ {need}).\",\n    activate: \"Activer\", activating: \"Activation : {message}\", activated: \"Activé. Cette adresse ne répond plus qu'à votre clé ML-DSA-44.\",\n    activationFailed: \"L'activation s'est arrêtée : {error}\",\n    sendTitle: \"Envoyer des KOIN\", to: \"À\", amount: \"Montant (KOIN)\", sendBtn: \"Envoyer\",\n    confirmLast6: \"Tapez les 6 derniers caractères de cette nouvelle adresse\",\n    toKnown: \"Vous avez déjà envoyé à cette adresse.\",\n    toNew: \"Une nouvelle adresse. Vérifiez-la caractère par caractère, puis tapez ses 6 derniers caractères ci-dessous.\",\n    toLookalike: \"Attention : elle ressemble à {addr}, que vous avez utilisée, mais c'est une autre adresse.\",\n    toSelf: \"C'est l'adresse de ce portefeuille.\", toInvalid: \"Ce n'est pas une adresse Koinos valide.\",\n    sentWait: \"Envoyé : {tx}. En attente d'un bloc…\", sentMined: \"Dans le bloc {block}.\", sentUnconfirmed: \"Pas encore vu dans un bloc. Vérifiez l'explorateur avant de renvoyer.\",\n    historyTitle: \"Activité récente\", noHistory: \"Rien pour l'instant.\",\n    received: \"Reçu {amt} de {from}\", sentTo: \"Envoyé {amt} à {to}\", otherActivity: \"Autre activité\", reverted: \"(annulée)\",\n    settingsTitle: \"Réglages\", share: \"Laisser les autres plugins KAI utiliser ce portefeuille\",\n    shareHint: \"Ils pourront voir l'adresse et le solde et demander un paiement. Vous validez chaque paiement vous-même, dans KAI.\",\n    reveal: \"Afficher les mots de récupération\", remove: \"Retirer le portefeuille de cet ordinateur\",\n    localOnly: \"KAI est en mode Local uniquement, donc le portefeuille ne peut pas joindre le réseau Koinos. Votre clé est en sécurité sur cet ordinateur ; changez la confidentialité dans KAI pour l'utiliser.\",\n    noSecure: \"Cet ordinateur ne peut pas chiffrer correctement une clé de portefeuille, donc Sparán n'en gardera pas ici.\",\n    testnetNote: \"Testnet (Harbinger) : KOIN de test uniquement. Les mêmes mots donnent la même adresse sur les deux réseaux.\",\n  };\n  const de = {\n    lede: \"Eine Post-Quanten-Wallet für Koinos. Ihr Konto hört nur auf einen ML-DSA-44-Schlüssel.\",\n    network: \"Netz\",\n    pillNoWallet: \"Keine Wallet\", pillNotActive: \"Nicht aktiviert\", pillActive: \"Post-Quanten\", pillLocal: \"Nur lokal\", pillChecking: \"Prüfe…\",\n    setupTitle: \"Wallet einrichten\",\n    setupHint: \"Die Wallet ist eine Wiederherstellungsphrase aus 24 Wörtern. Sparán bewahrt sie auf diesem Computer auf, verschlüsselt von Ihrem Betriebssystem. Niemand sonst hat eine Kopie, also schreiben Sie die Wörter auf Papier.\",\n    createNew: \"Neue Wallet erstellen\", restore: \"Mit 24 Wörtern wiederherstellen\",\n    wordsTitle: \"Ihre Wiederherstellungswörter\",\n    wordsWarn: \"Schreiben Sie diese 24 Wörter der Reihe nach auf Papier. Wer sie hat, kann Ihre KOIN nehmen. Verlieren Sie sie und diesen Computer, kann niemand sie zurückholen.\",\n    checkHint: \"Zur Sicherheit tippen Sie diese drei Wörter aus Ihrer Liste:\",\n    wordN: \"Wort {n}\",\n    written: \"Ich habe sie notiert\", saveWallet: \"Wallet speichern\", cancel: \"Abbrechen\", hide: \"Verbergen\",\n    restoreTitle: \"Wallet wiederherstellen\", restoreHint: \"Tippen oder fügen Sie die 24 Wörter ein, getrennt durch Leerzeichen.\",\n    address: \"Adresse\", copy: \"Kopieren\", copied: \"Kopiert\", explorer: \"Explorer\", mana: \"Mana\", refresh: \"Aktualisieren\",\n    manaHint: \"Mana bezahlt Transaktionen. Es sind keine ausgegebenen KOIN: Mana füllt sich in 5 Tagen bis zu Ihrem KOIN-Guthaben wieder auf.\",\n    activateTitle: \"Post-Quanten-Schutz aktivieren\",\n    activateHint: \"Bis zur Aktivierung ist dies eine gewöhnliche Koinos-Adresse. Die Aktivierung installiert den koinos-pq-Vertrag und registriert Ihren ML-DSA-44-Schlüssel in einer Transaktion. Danach kann nur dieser Schlüssel ihre KOIN bewegen.\",\n    needLine: \"Die Aktivierung braucht etwa {need} KOIN Mana. Diese Wallet hat {have}. Senden Sie zuerst KOIN an die Adresse oben.\",\n    needOk: \"Diese Wallet hat {have} KOIN Mana, genug zum Aktivieren (etwa {need} nötig).\",\n    activate: \"Aktivieren\", activating: \"Aktivierung: {message}\", activated: \"Aktiviert. Diese Adresse hört jetzt nur noch auf Ihren ML-DSA-44-Schlüssel.\",\n    activationFailed: \"Aktivierung abgebrochen: {error}\",\n    sendTitle: \"KOIN senden\", to: \"An\", amount: \"Betrag (KOIN)\", sendBtn: \"Senden\",\n    confirmLast6: \"Tippen Sie die letzten 6 Zeichen dieser neuen Adresse\",\n    toKnown: \"An diese Adresse haben Sie schon gesendet.\",\n    toNew: \"Eine neue Adresse. Prüfen Sie sie Zeichen für Zeichen und tippen Sie unten ihre letzten 6 Zeichen.\",\n    toLookalike: \"Vorsicht: Sie sieht aus wie {addr}, die Sie benutzt haben, ist aber eine andere Adresse.\",\n    toSelf: \"Das ist die Adresse dieser Wallet.\", toInvalid: \"Keine gültige Koinos-Adresse.\",\n    sentWait: \"Gesendet: {tx}. Warte auf einen Block…\", sentMined: \"In Block {block}.\", sentUnconfirmed: \"Noch in keinem Block gesehen. Prüfen Sie den Explorer, bevor Sie erneut senden.\",\n    historyTitle: \"Letzte Aktivität\", noHistory: \"Noch nichts.\",\n    received: \"{amt} von {from} erhalten\", sentTo: \"{amt} an {to} gesendet\", otherActivity: \"Andere Aktivität\", reverted: \"(rückgängig)\",\n    settingsTitle: \"Einstellungen\", share: \"Anderen KAI-Plugins diese Wallet erlauben\",\n    shareHint: \"Sie können Adresse und Guthaben sehen und eine Zahlung anfragen. Sie bestätigen jede Zahlung selbst, in KAI.\",\n    reveal: \"Wiederherstellungswörter anzeigen\", remove: \"Wallet von diesem Computer entfernen\",\n    localOnly: \"KAI steht auf „Nur lokal“, daher erreicht die Wallet das Koinos-Netz nicht. Ihr Schlüssel ist auf diesem Computer sicher; ändern Sie den Datenschutz in KAI, um sie zu nutzen.\",\n    noSecure: \"Dieser Computer kann einen Wallet-Schlüssel nicht richtig verschlüsseln, daher hält Sparán hier keinen.\",\n    testnetNote: \"Testnet (Harbinger): nur Test-KOIN. Dieselben Wörter ergeben in beiden Netzen dieselbe Adresse.\",\n  };\n  const catalogs = { en, es, \"pt-BR\": ptBR, fr, de };\n  let language = \"en\";\n  function t(key, params) {\n    const s = (catalogs[language] && catalogs[language][key]) ?? en[key] ?? key;\n    return params ? s.replace(/\\{(\\w+)\\}/g, (_, k) => (params[k] ?? \"\")) : s;\n  }\n  window.SparanI18n = {\n    t,\n    catalogs,\n    get language() { return language; },\n    set(lang) { language = Object.hasOwn(catalogs, lang) ? lang : \"en\"; },\n    apply(root = document) {\n      for (const el of root.querySelectorAll(\"[data-i18n]\")) el.textContent = t(el.dataset.i18n);\n    },\n  };\n})();\n","index.html":"<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Sparán</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"i18n.js\" defer></script>\n  <script src=\"app.js\" defer></script>\n</head>\n<body>\n  <main>\n    <header class=\"top\">\n      <div>\n        <h1>Sparán</h1>\n        <p class=\"lede\" data-i18n=\"lede\">A post-quantum Koinos wallet. Your account answers only to an ML-DSA-44 key.</p>\n      </div>\n      <div class=\"top-right\">\n        <label class=\"net\"><span data-i18n=\"network\">Network</span>\n          <select id=\"network\"><option value=\"mainnet\">Mainnet</option><option value=\"testnet\">Testnet (Harbinger)</option></select>\n        </label>\n        <span id=\"pill\" class=\"pill\" role=\"status\" aria-live=\"polite\">—</span>\n      </div>\n    </header>\n\n    <p id=\"error\" class=\"error\" role=\"alert\" hidden></p>\n    <p id=\"notice\" class=\"notice\" hidden></p>\n\n    <!-- No wallet yet -->\n    <section class=\"card\" id=\"setup\" hidden>\n      <h2 data-i18n=\"setupTitle\">Set up your wallet</h2>\n      <p data-i18n=\"setupHint\">The wallet is a 24-word recovery phrase. Sparán keeps it on this computer, encrypted by your operating system. Nobody else has a copy, so write the words down on paper.</p>\n      <div class=\"row-buttons\">\n        <button id=\"btn-new\" type=\"button\" class=\"primary\" data-i18n=\"createNew\">Create a new wallet</button>\n        <button id=\"btn-restore\" type=\"button\" data-i18n=\"restore\">Restore from 24 words</button>\n      </div>\n    </section>\n\n    <section class=\"card\" id=\"words-card\" hidden>\n      <h2 data-i18n=\"wordsTitle\">Your recovery words</h2>\n      <p class=\"warn\" data-i18n=\"wordsWarn\">Write these 24 words down, in order, on paper. Anyone with them can take your KOIN. If you lose them and this computer, nobody can get it back.</p>\n      <ol id=\"words\" class=\"words\"></ol>\n      <div id=\"check\" hidden>\n        <p data-i18n=\"checkHint\">To make sure, type these three words from your list:</p>\n        <div id=\"check-fields\" class=\"check-fields\"></div>\n      </div>\n      <div class=\"row-buttons\">\n        <button id=\"btn-written\" type=\"button\" class=\"primary\" data-i18n=\"written\">I've written them down</button>\n        <button id=\"btn-save-new\" type=\"button\" class=\"primary\" data-i18n=\"saveWallet\" hidden>Save the wallet</button>\n        <button id=\"btn-cancel-new\" type=\"button\" data-i18n=\"cancel\">Cancel</button>\n      </div>\n    </section>\n\n    <section class=\"card\" id=\"restore-card\" hidden>\n      <h2 data-i18n=\"restoreTitle\">Restore a wallet</h2>\n      <p data-i18n=\"restoreHint\">Type or paste the 24 words, separated by spaces.</p>\n      <textarea id=\"restore-words\" rows=\"4\" spellcheck=\"false\" autocomplete=\"off\" autocapitalize=\"off\"></textarea>\n      <div class=\"row-buttons\">\n        <button id=\"btn-restore-go\" type=\"button\" class=\"primary\" data-i18n=\"restore\">Restore from 24 words</button>\n        <button id=\"btn-restore-cancel\" type=\"button\" data-i18n=\"cancel\">Cancel</button>\n      </div>\n    </section>\n\n    <!-- The wallet -->\n    <section class=\"card\" id=\"wallet\" hidden>\n      <div class=\"row\">\n        <div class=\"grow\">\n          <div class=\"label\" data-i18n=\"address\">Address</div>\n          <code id=\"address\" class=\"address\">—</code>\n        </div>\n        <div class=\"row-buttons\">\n          <button id=\"btn-copy\" type=\"button\" data-i18n=\"copy\">Copy</button>\n          <button id=\"btn-explorer-addr\" type=\"button\" data-i18n=\"explorer\">Explorer</button>\n        </div>\n      </div>\n      <div class=\"stats\">\n        <div><div class=\"label\">KOIN</div><div id=\"koin\" class=\"big\">—</div></div>\n        <div><div class=\"label\" data-i18n=\"mana\">Mana</div><div id=\"mana\" class=\"big\">—</div></div>\n        <button id=\"btn-refresh\" type=\"button\" class=\"small\" data-i18n=\"refresh\">Refresh</button>\n      </div>\n      <p class=\"hint\" data-i18n=\"manaHint\">Mana pays for transactions. It is not spent KOIN: it refills over 5 days, up to your KOIN balance.</p>\n    </section>\n\n    <section class=\"card\" id=\"activate\" hidden>\n      <h2 data-i18n=\"activateTitle\">Activate post-quantum protection</h2>\n      <p data-i18n=\"activateHint\">Until it's activated, this address is an ordinary Koinos address. Activating installs the koinos-pq contract on it and registers your ML-DSA-44 key, in one transaction. After that only that key can move its KOIN.</p>\n      <p id=\"activate-need\" class=\"hint\"></p>\n      <p id=\"activate-progress\" class=\"progress\" aria-live=\"polite\" hidden></p>\n      <button id=\"btn-activate\" type=\"button\" class=\"primary\" data-i18n=\"activate\">Activate</button>\n    </section>\n\n    <section class=\"card\" id=\"send\" hidden>\n      <h2 data-i18n=\"sendTitle\">Send KOIN</h2>\n      <label class=\"field\"><span data-i18n=\"to\">To</span>\n        <input id=\"to\" type=\"text\" spellcheck=\"false\" autocomplete=\"off\" placeholder=\"1…\">\n      </label>\n      <p id=\"to-note\" class=\"hint\" hidden></p>\n      <label class=\"field\" id=\"confirm-new-field\" hidden><span data-i18n=\"confirmLast6\">Type the last 6 characters of this new address</span>\n        <input id=\"confirm-new\" type=\"text\" maxlength=\"6\" spellcheck=\"false\" autocomplete=\"off\">\n      </label>\n      <label class=\"field\"><span data-i18n=\"amount\">Amount (KOIN)</span>\n        <input id=\"amount\" type=\"text\" inputmode=\"decimal\" autocomplete=\"off\" placeholder=\"0.0\">\n      </label>\n      <button id=\"btn-send\" type=\"button\" class=\"primary\" data-i18n=\"sendBtn\">Send</button>\n      <p id=\"send-result\" class=\"progress\" aria-live=\"polite\" hidden></p>\n    </section>\n\n    <section class=\"card\" id=\"history-card\" hidden>\n      <h2 data-i18n=\"historyTitle\">Recent activity</h2>\n      <ul id=\"history\" class=\"history\"></ul>\n    </section>\n\n    <section class=\"card\" id=\"settings\" hidden>\n      <h2 data-i18n=\"settingsTitle\">Settings</h2>\n      <label class=\"check\"><input id=\"share\" type=\"checkbox\"> <span data-i18n=\"share\">Let other KAI plugins use this wallet</span></label>\n      <p class=\"hint\" data-i18n=\"shareHint\">They can see the address and balance and ask for a payment. You approve every payment yourself, in KAI.</p>\n      <div class=\"row-buttons\">\n        <button id=\"btn-reveal\" type=\"button\" data-i18n=\"reveal\">Show recovery words</button>\n        <button id=\"btn-remove\" type=\"button\" class=\"danger\" data-i18n=\"remove\">Remove wallet from this computer</button>\n      </div>\n      <p class=\"hint small-print\" id=\"about\"></p>\n    </section>\n  </main>\n</body>\n</html>\n","LICENSE.txt":"MIT License\n\nCopyright (c) 2026 Justyoureverydaynormalguybob\n\nPermission is hereby granted, free of charge, to any person obtaining a copy\nof this software and associated documentation files (the \"Software\"), to deal\nin the Software without restriction, including without limitation the rights\nto use, copy, modify, merge, publish, distribute, sublicense, and/or sell\ncopies of the Software, and to permit persons to whom the Software is\nfurnished to do so, subject to the following conditions:\n\nThe above copyright notice and this permission notice shall be included in all\ncopies or substantial portions of the Software.\n\nTHE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR\nIMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,\nFITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE\nAUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER\nLIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,\nOUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE\nSOFTWARE.\n","service/index.js":"\"use strict\";\n/*\n * Sparán for KAI — native service.\n *\n * A post-quantum Koinos wallet. The account is a koinos-pq \"pqwallet\" account: the koinos-pq\n * contract is installed on the address and every authority is locked to it, so only an\n * ML-DSA-44 (NIST FIPS 204) signature moves its KOIN. The rules live in koinos-pq-core,\n * bundled in vendor/pq-core.cjs.\n *\n * Keys:\n *   - One wallet per KAI profile. Its 32-byte seed (the 24 recovery words) is encrypted with\n *     the operating system's secret store through api.secrets and kept in the plugin's\n *     settings. Nothing in plain text is ever written. The plugin refuses to hold a key where\n *     the OS can't really encrypt (no encryption, or Linux's \"basic_text\" fallback).\n *   - The seed is decrypted only for the operation that needs it and wiped afterwards.\n *\n * Approvals: every action with an outside effect (sending, activating, showing the recovery\n * words, removing the wallet, a payment another plugin asks for) goes through\n * api.desktop.confirm, KAI's own attended approval. It returns false while KAI is hidden.\n * One approval at a time, and a short pause after a decline.\n *\n * Network: every request goes through api.network.fetch (see rpc.js), so KAI's Local-Only\n * setting stops the wallet from talking to Koinos.\n *\n * Other plugins: the \"koinos.pq-wallet\" service is refused until the user turns on\n * \"Let other plugins use this wallet\". Even then, a payment is approved by the user every\n * time, in a dialog that names the plugin that asked.\n */\nconst core = require(\"./vendor/pq-core.cjs\");\nconst { makeChain, LocalOnlyError } = require(\"./rpc\");\nconst { messages } = require(\"./messages\");\n\nconst NETWORKS = [\"mainnet\", \"testnet\"];\nconst MODE = \"pqwallet\";\nconst DECLINE_COOLDOWN_MS = 3000;\nconst SERVICE = \"koinos.pq-wallet\";\nconst MAX_KNOWN = 200;\nconst HISTORY_MAX = 50;\n\nfunction create(api) {\n  if (api.version !== 1) throw Error(\"Sparán requires KAI Foundation API v1\");\n  let closed = false;\n  let approving = false;\n  let declinedAt = 0;\n  let pending = null;     // a newly generated phrase waiting for the user to confirm it was written down\n  let activation = null;  // { network, step, message, txId, error, done } while/after activating\n  const chains = new Map();\n  const sends = new Map(); // txId -> { network, status: \"sent\" | \"mined\" | \"failed\", block, error }\n\n  const m = () => messages(api.locale.get().language);\n  const alive = (signal) => {\n    if (closed) throw Error(\"Sparán is closed\");\n    api.signal.throwIfAborted();\n    signal?.throwIfAborted();\n  };\n\n  // ----- settings -----\n  const network = () => (NETWORKS.includes(api.settings.get(\"network\")) ? api.settings.get(\"network\") : \"mainnet\");\n  const chain = () => {\n    const n = network();\n    if (!chains.has(n)) chains.set(n, makeChain(core, api, n));\n    return chains.get(n);\n  };\n  const shareWithPlugins = () => api.settings.get(\"shareWithPlugins\", false) === true;\n  const known = () => {\n    const k = api.settings.get(`known.${network()}`, []);\n    return Array.isArray(k) ? k.filter((a) => typeof a === \"string\") : [];\n  };\n  const remember = (address) => {\n    const k = known().filter((a) => a !== address);\n    k.unshift(address);\n    api.settings.set(`known.${network()}`, k.slice(0, MAX_KNOWN));\n  };\n\n  // ----- the vault -----\n  function secureStorage() {\n    if (!api.secrets.isEncryptionAvailable()) return false;\n    // Electron's Linux fallback \"basic_text\" encrypts with a key anyone can find.\n    try { if (api.secrets.getSelectedStorageBackend?.() === \"basic_text\") return false; } catch { /* not reported */ }\n    return true;\n  }\n  const vault = () => api.settings.get(\"vault\", null);\n  const hasWallet = () => !!(vault() && typeof vault().seed === \"string\");\n\n  /** Run fn with the wallet's keys; the seed and secret key are wiped afterwards. */\n  async function withKeys(fn) {\n    const v = vault();\n    if (!v || typeof v.seed !== \"string\") throw Error(m().noWallet);\n    if (!secureStorage()) throw Error(m().noSecureStorage);\n    const hex = api.secrets.decryptString(Buffer.from(v.seed, \"base64\"));\n    const seed = Uint8Array.from(Buffer.from(hex, \"hex\"));\n    if (seed.length !== 32) throw Error(\"the stored wallet is damaged\");\n    const keys = core.deriveKeys(seed);\n    try {\n      return await fn(keys);\n    } finally {\n      core.wipe(seed, keys.seed, keys.secretKey);\n    }\n  }\n\n  function storeSeed(seed) {\n    if (!secureStorage()) throw Error(m().noSecureStorage);\n    const keys = core.deriveKeys(seed);\n    const address = core.bootstrapAddress(keys);\n    const sealed = Buffer.from(api.secrets.encryptString(Buffer.from(seed).toString(\"hex\"))).toString(\"base64\");\n    api.settings.set(\"vault\", { seed: sealed, address, createdAt: new Date().toISOString() });\n    core.wipe(keys.seed, keys.secretKey);\n    return address;\n  }\n  const address = () => (vault() ? vault().address : null);\n\n  // ----- approvals -----\n  async function approve(title, detail, signal) {\n    if (approving) throw Error(m().approvalBusy);\n    if (Date.now() - declinedAt < DECLINE_COOLDOWN_MS) throw Error(m().justDeclined);\n    approving = true;\n    try {\n      const ok = await api.desktop.confirm(title, detail, signal);\n      if (!ok) {\n        declinedAt = Date.now();\n        throw Object.assign(Error(m().notApproved), { code: \"NOT_APPROVED\" });\n      }\n    } finally {\n      approving = false;\n    }\n  }\n\n  // ----- reads -----\n  const fmt = (base) => core.formatKoin(BigInt(base));\n\n  async function balances(signal) {\n    alive(signal);\n    const a = address();\n    if (!a) throw Error(m().noWallet);\n    const c = chain();\n    const [koin, mana] = await Promise.all([c.balance(a), c.mana(a)]);\n    return { address: a, network: network(), koin: fmt(koin), koinBase: koin.toString(), mana: fmt(mana), manaBase: mana.toString() };\n  }\n\n  async function activationInfo(signal) {\n    alive(signal);\n    const a = address();\n    if (!a) throw Error(m().noWallet);\n    const c = chain();\n    const [info, costs, mana] = await Promise.all([core.pqwalletInfo(c, a), core.estimateSetupCosts(c), c.mana(a)]);\n    let keyMatches = null;\n    if (info.deployed && info.keyRegistered) {\n      const pk = await core.registeredPublicKey(c, a);\n      keyMatches = await withKeys(async (keys) => !!pk && pk.length === keys.publicKey.length && pk.every((b, i) => b === keys.publicKey[i]));\n    }\n    return {\n      deployed: info.deployed,\n      keyRegistered: info.keyRegistered,\n      active: info.deployed && info.keyRegistered && keyMatches === true,\n      keyMatches,\n      requiredMana: fmt(costs.requiredMana),\n      mana: fmt(mana),\n      enoughMana: mana >= costs.requiredMana,\n    };\n  }\n\n  /** Is this a recipient the user has sent to before, or one that only looks like one? */\n  function recipientCheck(to) {\n    const list = known();\n    if (list.includes(to)) return { known: true, lookalike: null };\n    // Address poisoning: a planted address that shares the start and end of one you use.\n    const lookalike = list.find((k) => k !== to && k.slice(0, 4) === to.slice(0, 4) && k.slice(-4) === to.slice(-4)) || null;\n    return { known: false, lookalike };\n  }\n\n  function parseAmount(text) {\n    try { return core.parseKoin(String(text)); } catch (e) { throw Error(m().badAmount); }\n  }\n\n  // ----- sending -----\n  async function send({ to, amount, confirmNew, reason, caller }, signal) {\n    alive(signal);\n    if (api.network.status().privacyMode === \"local-only\") throw new LocalOnlyError();\n    if (typeof to !== \"string\" || !core.isAddress(to)) throw Error(m().badAddress);\n    to = to.trim();\n    const value = parseAmount(amount);\n    if (value <= 0n) throw Error(m().badAmount);\n    const from = address();\n    if (!from) throw Error(m().noWallet);\n    if (to === from) throw Error(m().sendToSelf);\n\n    const check = recipientCheck(to);\n    // From the wallet's own window, a first-time recipient needs its last six characters\n    // typed (the window sends them as confirmNew). Another plugin can't do that, so for it the\n    // dialog itself says plainly that the address is new.\n    if (!caller && !check.known && confirmNew !== to.slice(-6)) {\n      throw Object.assign(Error(m().confirmNewRecipient), { code: \"CONFIRM_NEW\", lookalike: check.lookalike });\n    }\n\n    const c = chain();\n    const [have, info] = await Promise.all([c.balance(from), core.pqwalletInfo(c, from)]);\n    if (!info.deployed || !info.keyRegistered) throw Error(m().notActive);\n    if (value > have) throw Error(m().notEnough(fmt(have)));\n\n    const t = m();\n    const lines = [\n      t.dlgAmount(fmt(value)),\n      t.dlgTo(to),\n      t.dlgFrom(from),\n      t.dlgNetwork(network()),\n      check.known ? t.dlgKnown : t.dlgNew,\n    ];\n    if (check.lookalike) lines.push(t.dlgLookalike(check.lookalike));\n    if (caller) lines.unshift(t.dlgCaller(caller), reason ? t.dlgReason(reason) : t.dlgNoReason, \"\");\n    lines.push(\"\", t.dlgFinal);\n    await approve(caller ? t.dlgTitlePlugin(caller) : t.dlgTitleSend, lines.join(\"\\n\"), signal);\n\n    const result = await withKeys((keys) => c.sendKoin({ from, to, valueBase: value, keys, mode: MODE }));\n    remember(to);\n    const net = network();\n    sends.set(result.txId, { network: net, status: \"sent\" });\n    // Watch for the block in the background; the window polls send.status.\n    c.waitMined(result.txId, 180_000)\n      .then((block) => sends.set(result.txId, { network: net, status: \"mined\", block }))\n      .catch((e) => sends.set(result.txId, { network: net, status: \"unconfirmed\", error: String(e.message || e).slice(0, 200) }));\n    return { txId: result.txId, network: net, explorer: explorer(net, result.txId) };\n  }\n\n  function explorer(net, txId) {\n    const n = core.NETWORKS[net];\n    return n && n.explorerTx ? n.explorerTx(txId) : null;\n  }\n\n  // ----- activation -----\n  async function activate(signal) {\n    alive(signal);\n    if (activation && !activation.done) throw Error(m().activationRunning);\n    const info = await activationInfo(signal);\n    if (info.active) return { alreadyActive: true };\n    if (info.deployed && info.keyRegistered && info.keyMatches === false) throw Error(m().otherKey);\n    if (!info.enoughMana) throw Error(m().needMana(info.requiredMana, info.mana));\n    const t = m();\n    await approve(t.actTitle, [t.actDetail(address(), network(), info.requiredMana), \"\", t.actFinal].join(\"\\n\"), signal);\n    const net = network();\n    activation = { network: net, step: \"checking\", message: t.actStarting, txId: null, error: null, done: false };\n    const c = chain();\n    // Not awaited: activation can take minutes while the network releases a mana hold.\n    withKeys((keys) => core.setupPqwalletAccount(c, keys, (s) => { activation = { ...activation, step: s.step, message: s.message, txId: s.txId || activation.txId }; }))\n      .then(() => { activation = { ...activation, step: \"done\", done: true }; })\n      .catch((e) => { activation = { ...activation, done: true, error: String(e.message || e).slice(0, 300) }; });\n    return { started: true };\n  }\n\n  // ----- the window's methods -----\n  async function state() {\n    const privacyMode = api.network.status().privacyMode;\n    return {\n      hasWallet: hasWallet(),\n      address: address(),\n      network: network(),\n      networks: NETWORKS,\n      secureStorage: secureStorage(),\n      privacyMode,\n      localOnly: privacyMode === \"local-only\",\n      shareWithPlugins: shareWithPlugins(),\n      activation,\n      pqwalletWasmSha256: core.PQWALLET_WASM_SHA256,\n    };\n  }\n\n  const handlers = {\n    \"state\": () => state(),\n\n    // A new phrase is generated here and kept in memory until the window confirms it was written down.\n    \"wallet.generate\": async () => {\n      if (hasWallet()) throw Error(m().alreadyHaveWallet);\n      if (!secureStorage()) throw Error(m().noSecureStorage);\n      pending = core.newMnemonic();\n      return { words: pending.split(\" \") };\n    },\n    \"wallet.confirmGenerated\": async (input) => {\n      if (!pending) throw Error(m().nothingPending);\n      const words = pending.split(\" \");\n      const checks = Array.isArray(input && input.checks) ? input.checks : [];\n      if (checks.length < 3 || !checks.every((c) => Number.isInteger(c.index) && words[c.index] === String(c.word || \"\").trim().toLowerCase())) {\n        throw Error(m().wordsDontMatch);\n      }\n      const seed = core.mnemonicToSeed(pending);\n      pending = null;\n      try { return { address: storeSeed(seed) }; } finally { core.wipe(seed); }\n    },\n    \"wallet.restore\": async (input, signal) => {\n      const phrase = core.normalizeMnemonic(String((input && input.words) || \"\"));\n      if (!core.isMnemonic(phrase)) throw Error(m().badPhrase);\n      if (hasWallet()) await approve(m().replaceTitle, m().replaceDetail(address()), signal);\n      const seed = core.mnemonicToSeed(phrase);\n      try { return { address: storeSeed(seed) }; } finally { core.wipe(seed); }\n    },\n    \"wallet.reveal\": async (_input, signal) => {\n      await approve(m().revealTitle, m().revealDetail, signal);\n      return withKeys(async (keys) => ({ words: core.seedToMnemonic(keys.seed).split(\" \") }));\n    },\n    \"wallet.remove\": async (_input, signal) => {\n      if (!hasWallet()) return { removed: false };\n      await approve(m().removeTitle, m().removeDetail(address()), signal);\n      api.settings.set(\"vault\", null);\n      activation = null;\n      return { removed: true };\n    },\n\n    \"network.set\": async (input) => {\n      const n = input && input.network;\n      if (!NETWORKS.includes(n)) throw Error(\"unknown network\");\n      api.settings.set(\"network\", n);\n      activation = null;\n      return { network: n };\n    },\n    \"share.set\": async (input, signal) => {\n      const on = !!(input && input.on);\n      if (on) await approve(m().shareTitle, m().shareDetail, signal);\n      api.settings.set(\"shareWithPlugins\", on);\n      return { shareWithPlugins: on };\n    },\n\n    \"balances\": (_i, signal) => balances(signal),\n    \"activation.info\": (_i, signal) => activationInfo(signal),\n    \"activation.start\": (_i, signal) => activate(signal),\n    \"history\": async (input, signal) => {\n      alive(signal);\n      const a = address();\n      if (!a) throw Error(m().noWallet);\n      const limit = Math.min(Math.max(Number(input && input.limit) || 20, 1), HISTORY_MAX);\n      const items = await chain().history(a, limit);\n      return { items: items.map((it) => ({ ...it, amount: it.valueBase ? fmt(it.valueBase) : null, isKoin: it.contract === core.NETWORKS[network()].koin, explorer: it.txId ? explorer(network(), it.txId) : null })) };\n    },\n    \"recipient.check\": async (input) => {\n      const to = String((input && input.to) || \"\").trim();\n      if (!core.isAddress(to)) return { valid: false };\n      return { valid: true, ...recipientCheck(to), self: to === address() };\n    },\n    \"send\": (input, signal) => send({ to: input && input.to, amount: input && input.amount, confirmNew: input && input.confirmNew }, signal),\n    \"send.status\": async (input) => sends.get(String((input && input.txId) || \"\")) || null,\n    // Opens a transaction or the wallet's address on the explorer. The URL is built here from a\n    // checked id, never taken from the window, and KAI reviews it before opening.\n    \"explorer.open\": async (input) => {\n      const txId = String((input && input.txId) || \"\");\n      const n = core.NETWORKS[network()];\n      if (/^0x1220[0-9a-f]{64}$/.test(txId) && n.explorerTx) return api.desktop.openExternal(n.explorerTx(txId));\n      if (input && input.address === true && address()) {\n        const base = network() === \"mainnet\" ? \"https://koinosblocks.com\" : \"https://harbinger.koinosblocks.com\";\n        return api.desktop.openExternal(`${base}/address/${address()}`);\n      }\n      throw Error(\"nothing to open\");\n    },\n  };\n\n  // ----- the service other plugins can call -----\n  let removeProvider = () => {};\n  try {\n    removeProvider = api.services.provide(SERVICE, {\n      methods: [\"status\", \"balance\", \"requestPayment\"],\n      async call(method, input, context) {\n        context.signal.throwIfAborted();\n        if (context.remote) throw Error(\"Sparán serves local plugins only\");\n        if (!shareWithPlugins()) throw Error(\"Sparán: the user hasn't allowed other plugins to use this wallet. Ask them to turn it on in Sparán.\");\n        if (!hasWallet()) throw Error(\"Sparán has no wallet yet\");\n        if (method === \"status\") return { address: address(), network: network() };\n        if (method === \"balance\") {\n          const b = await balances(context.signal);\n          return { address: b.address, network: b.network, koin: b.koin, mana: b.mana };\n        }\n        if (method === \"requestPayment\") {\n          const caller = String(context.caller || \"an unnamed plugin\").slice(0, 100);\n          const reason = typeof (input && input.reason) === \"string\" ? input.reason.replace(/[\\u0000-\\u001f\\u007f‪-‮⁦-⁩]/g, \" \").slice(0, 200) : \"\";\n          return send({ to: input && input.to, amount: input && input.amount, reason, caller }, context.signal);\n        }\n        throw Error(`unknown method ${method}`);\n      },\n    });\n  } catch (e) {\n    // Another enabled plugin may already provide the name; the wallet still works on its own.\n    api.log(\"warn\", `could not provide ${SERVICE}: ${e.message}`);\n  }\n\n  function dispose() {\n    if (closed) return;\n    closed = true;\n    pending = null;\n    try { removeProvider(); } catch { /* already gone */ }\n    api.signal.removeEventListener(\"abort\", dispose);\n  }\n  api.signal.addEventListener(\"abort\", dispose, { once: true });\n\n  return {\n    async call(method, input, signal) {\n      alive(signal);\n      const h = Object.hasOwn(handlers, method) ? handlers[method] : null;\n      if (!h) throw Error(`unknown method ${method}`);\n      try {\n        return await h(input || {}, signal);\n      } catch (e) {\n        if (e instanceof LocalOnlyError) throw Error(m().localOnly);\n        throw e;\n      }\n    },\n    windowClosed() { pending = null; }, // a phrase nobody confirmed is dropped, never stored\n    dispose,\n  };\n}\n\nmodule.exports = { create };\n","service/messages.js":"\"use strict\";\n// Text the service shows in KAI's approval dialogs and in errors, in the five languages KAI Core\n// supports. Core keeps dialog content literal, so the plugin localises it (PLUGIN_AUTHOR_GUIDE,\n// \"Shared language\"). Addresses, amounts and plugin ids stay as they are. Missing keys fall back\n// to English.\n\nconst en = {\n  noWallet: \"There is no wallet yet. Create one or restore it from its 24 words.\",\n  noSecureStorage: \"This computer can't encrypt the wallet key properly (no OS secret store, or Linux's plain-text fallback), so Sparán won't hold one here.\",\n  approvalBusy: \"Another Sparán approval is already open in KAI. Finish that one first.\",\n  justDeclined: \"You just declined. Wait a moment before trying again.\",\n  notApproved: \"Not approved. Nothing was sent or changed. (Approvals need the KAI window open and visible.)\",\n  localOnly: \"KAI is set to Local-Only, so Sparán can't reach the Koinos network. Change privacy in KAI to use the wallet.\",\n  badAddress: \"That isn't a valid Koinos address.\",\n  badAmount: \"Enter an amount above 0 with at most 8 decimal places.\",\n  sendToSelf: \"That's this wallet's own address.\",\n  confirmNewRecipient: \"You haven't sent to this address before. Type its last 6 characters to confirm it.\",\n  notActive: \"This wallet isn't activated yet, so it can't send. Activate it first.\",\n  notEnough: (have) => `Not enough KOIN: this wallet has ${have}.`,\n  alreadyHaveWallet: \"This KAI profile already has a wallet. Remove it first to make a new one.\",\n  nothingPending: \"Start again: no new phrase is waiting.\",\n  wordsDontMatch: \"Those words don't match your recovery phrase. Check what you wrote down.\",\n  badPhrase: \"That isn't a valid 24-word recovery phrase.\",\n  activationRunning: \"Activation is already running.\",\n  otherKey: \"This address is already registered to a different post-quantum key. Sparán won't touch it.\",\n  needMana: (need, have) => `Activation needs about ${need} KOIN of mana in the wallet; it has ${have}. Send KOIN to the address first. The KOIN isn't spent: mana refills over 5 days.`,\n\n  dlgTitleSend: \"Sparán: send KOIN?\",\n  dlgTitlePlugin: (caller) => `Sparán: ${caller} asks to send KOIN`,\n  dlgCaller: (caller) => `The plugin \"${caller}\" asks you to send this payment.`,\n  dlgReason: (reason) => `Its reason: \"${reason}\"`,\n  dlgNoReason: \"It gave no reason.\",\n  dlgAmount: (a) => `Amount: ${a} KOIN`,\n  dlgTo: (a) => `To: ${a}`,\n  dlgFrom: (a) => `From: ${a}`,\n  dlgNetwork: (n) => `Network: Koinos ${n}`,\n  dlgKnown: \"You have sent to this address before.\",\n  dlgNew: \"You have NEVER sent to this address before. Check every character.\",\n  dlgLookalike: (k) => `WARNING: it looks like ${k}, an address you have used, but it is a different address. This is how address-poisoning scams work.`,\n  dlgFinal: \"A sent transaction can't be undone.\",\n\n  actTitle: \"Sparán: activate post-quantum protection?\",\n  actDetail: (a, n, need) => `This installs the koinos-pq contract on ${a} (Koinos ${n}) and registers this wallet's ML-DSA-44 key. From then on only that key can move this address's KOIN.\\n\\nIt uses about ${need} KOIN of mana. The KOIN isn't spent: mana refills over 5 days.`,\n  actFinal: \"This can't be undone: the address will never again accept its old kind of signature.\",\n  actStarting: \"Starting\",\n\n  replaceTitle: \"Sparán: replace this wallet?\",\n  replaceDetail: (a) => `This KAI profile already holds the wallet ${a}. Restoring another removes it from this computer. Make sure you have its 24 words first, or its KOIN is lost.`,\n  revealTitle: \"Sparán: show the recovery words?\",\n  revealDetail: \"Anyone who sees these 24 words can take everything in this wallet. Check nobody can see your screen and that you're not sharing it.\",\n  removeTitle: \"Sparán: remove this wallet from this computer?\",\n  removeDetail: (a) => `The wallet ${a} is deleted from this KAI profile. Its KOIN stays on the blockchain, and only its 24 recovery words can bring it back. Without them it's gone for good.`,\n  shareTitle: \"Sparán: let other plugins use this wallet?\",\n  shareDetail: \"Other plugins you've installed in KAI will be able to see this wallet's address and balance, and to ask for payments. You approve every payment yourself, in a dialog that names the plugin asking.\",\n};\n\nconst es = {\n  noWallet: \"Aún no hay monedero. Crea uno o restáuralo con sus 24 palabras.\",\n  noSecureStorage: \"Este ordenador no puede cifrar bien la clave del monedero (sin almacén de secretos del sistema, o el modo de texto plano de Linux), así que Sparán no guardará una aquí.\",\n  approvalBusy: \"Ya hay otra aprobación de Sparán abierta en KAI. Termina esa primero.\",\n  justDeclined: \"Acabas de rechazarlo. Espera un momento antes de intentarlo de nuevo.\",\n  notApproved: \"No aprobado. No se ha enviado ni cambiado nada. (Las aprobaciones necesitan la ventana de KAI abierta y visible.)\",\n  localOnly: \"KAI está en Solo local, así que Sparán no puede conectar con la red Koinos. Cambia la privacidad en KAI para usar el monedero.\",\n  badAddress: \"Esa no es una dirección de Koinos válida.\",\n  badAmount: \"Introduce una cantidad mayor que 0 con 8 decimales como máximo.\",\n  sendToSelf: \"Esa es la dirección de este mismo monedero.\",\n  confirmNewRecipient: \"No has enviado nunca a esta dirección. Escribe sus últimos 6 caracteres para confirmarla.\",\n  notActive: \"Este monedero aún no está activado, así que no puede enviar. Actívalo primero.\",\n  notEnough: (have) => `No hay suficiente KOIN: este monedero tiene ${have}.`,\n  alreadyHaveWallet: \"Este perfil de KAI ya tiene un monedero. Quítalo primero para crear otro.\",\n  nothingPending: \"Empieza de nuevo: no hay ninguna frase nueva esperando.\",\n  wordsDontMatch: \"Esas palabras no coinciden con tu frase de recuperación. Revisa lo que anotaste.\",\n  badPhrase: \"Esa no es una frase de recuperación válida de 24 palabras.\",\n  activationRunning: \"La activación ya está en marcha.\",\n  otherKey: \"Esta dirección ya está registrada con otra clave poscuántica. Sparán no la tocará.\",\n  needMana: (need, have) => `La activación necesita unos ${need} KOIN de maná en el monedero; tiene ${have}. Envía KOIN a la dirección primero. El KOIN no se gasta: el maná se recarga en 5 días.`,\n  dlgTitleSend: \"Sparán: ¿enviar KOIN?\",\n  dlgTitlePlugin: (caller) => `Sparán: ${caller} pide enviar KOIN`,\n  dlgCaller: (caller) => `El plugin \"${caller}\" te pide enviar este pago.`,\n  dlgReason: (reason) => `Su motivo: \"${reason}\"`,\n  dlgNoReason: \"No ha dado ningún motivo.\",\n  dlgAmount: (a) => `Cantidad: ${a} KOIN`,\n  dlgTo: (a) => `A: ${a}`,\n  dlgFrom: (a) => `Desde: ${a}`,\n  dlgNetwork: (n) => `Red: Koinos ${n}`,\n  dlgKnown: \"Ya has enviado antes a esta dirección.\",\n  dlgNew: \"NUNCA has enviado a esta dirección. Revisa cada carácter.\",\n  dlgLookalike: (k) => `AVISO: se parece a ${k}, una dirección que has usado, pero es otra distinta. Así funcionan las estafas de envenenamiento de direcciones.`,\n  dlgFinal: \"Una transacción enviada no se puede deshacer.\",\n  actTitle: \"Sparán: ¿activar la protección poscuántica?\",\n  actDetail: (a, n, need) => `Esto instala el contrato koinos-pq en ${a} (Koinos ${n}) y registra la clave ML-DSA-44 de este monedero. Desde entonces solo esa clave puede mover el KOIN de esta dirección.\\n\\nUsa unos ${need} KOIN de maná. El KOIN no se gasta: el maná se recarga en 5 días.`,\n  actFinal: \"No se puede deshacer: la dirección no volverá a aceptar su antiguo tipo de firma.\",\n  actStarting: \"Empezando\",\n  replaceTitle: \"Sparán: ¿sustituir este monedero?\",\n  replaceDetail: (a) => `Este perfil de KAI ya guarda el monedero ${a}. Restaurar otro lo quita de este ordenador. Asegúrate de tener antes sus 24 palabras o su KOIN se perderá.`,\n  revealTitle: \"Sparán: ¿mostrar las palabras de recuperación?\",\n  revealDetail: \"Quien vea estas 24 palabras puede llevarse todo lo que hay en este monedero. Comprueba que nadie ve tu pantalla y que no la estás compartiendo.\",\n  removeTitle: \"Sparán: ¿quitar este monedero de este ordenador?\",\n  removeDetail: (a) => `El monedero ${a} se borra de este perfil de KAI. Su KOIN sigue en la cadena de bloques, y solo sus 24 palabras pueden recuperarlo. Sin ellas se pierde para siempre.`,\n  shareTitle: \"Sparán: ¿dejar que otros plugins usen este monedero?\",\n  shareDetail: \"Otros plugins que has instalado en KAI podrán ver la dirección y el saldo de este monedero y pedir pagos. Tú apruebas cada pago, en un diálogo que nombra al plugin que lo pide.\",\n};\n\nconst ptBR = {\n  noWallet: \"Ainda não há carteira. Crie uma ou restaure-a com as 24 palavras.\",\n  noSecureStorage: \"Este computador não consegue criptografar bem a chave da carteira (sem cofre de segredos do sistema, ou o modo de texto simples do Linux), então o Sparán não vai guardar uma aqui.\",\n  approvalBusy: \"Já há outra aprovação do Sparán aberta no KAI. Termine essa primeiro.\",\n  justDeclined: \"Você acabou de recusar. Espere um momento antes de tentar de novo.\",\n  notApproved: \"Não aprovado. Nada foi enviado nem alterado. (As aprovações precisam da janela do KAI aberta e visível.)\",\n  localOnly: \"O KAI está em Somente local, então o Sparán não consegue acessar a rede Koinos. Mude a privacidade no KAI para usar a carteira.\",\n  badAddress: \"Esse não é um endereço Koinos válido.\",\n  badAmount: \"Informe um valor acima de 0 com no máximo 8 casas decimais.\",\n  sendToSelf: \"Esse é o endereço desta própria carteira.\",\n  confirmNewRecipient: \"Você nunca enviou para este endereço. Digite os 6 últimos caracteres para confirmar.\",\n  notActive: \"Esta carteira ainda não está ativada, então não pode enviar. Ative-a primeiro.\",\n  notEnough: (have) => `KOIN insuficiente: esta carteira tem ${have}.`,\n  alreadyHaveWallet: \"Este perfil do KAI já tem uma carteira. Remova-a primeiro para criar outra.\",\n  nothingPending: \"Recomece: não há nenhuma frase nova esperando.\",\n  wordsDontMatch: \"Essas palavras não correspondem à sua frase de recuperação. Confira o que anotou.\",\n  badPhrase: \"Essa não é uma frase de recuperação válida de 24 palavras.\",\n  activationRunning: \"A ativação já está em andamento.\",\n  otherKey: \"Este endereço já está registrado com outra chave pós-quântica. O Sparán não vai mexer nele.\",\n  needMana: (need, have) => `A ativação precisa de cerca de ${need} KOIN de mana na carteira; ela tem ${have}. Envie KOIN para o endereço primeiro. O KOIN não é gasto: a mana se recarrega em 5 dias.`,\n  dlgTitleSend: \"Sparán: enviar KOIN?\",\n  dlgTitlePlugin: (caller) => `Sparán: ${caller} pede para enviar KOIN`,\n  dlgCaller: (caller) => `O plugin \"${caller}\" pede que você envie este pagamento.`,\n  dlgReason: (reason) => `O motivo: \"${reason}\"`,\n  dlgNoReason: \"Não deu nenhum motivo.\",\n  dlgAmount: (a) => `Valor: ${a} KOIN`,\n  dlgTo: (a) => `Para: ${a}`,\n  dlgFrom: (a) => `De: ${a}`,\n  dlgNetwork: (n) => `Rede: Koinos ${n}`,\n  dlgKnown: \"Você já enviou para este endereço antes.\",\n  dlgNew: \"Você NUNCA enviou para este endereço. Confira cada caractere.\",\n  dlgLookalike: (k) => `ATENÇÃO: parece ${k}, um endereço que você usou, mas é outro. É assim que funcionam os golpes de envenenamento de endereço.`,\n  dlgFinal: \"Uma transação enviada não pode ser desfeita.\",\n  actTitle: \"Sparán: ativar a proteção pós-quântica?\",\n  actDetail: (a, n, need) => `Isto instala o contrato koinos-pq em ${a} (Koinos ${n}) e registra a chave ML-DSA-44 desta carteira. A partir daí só essa chave pode mover o KOIN deste endereço.\\n\\nUsa cerca de ${need} KOIN de mana. O KOIN não é gasto: a mana se recarrega em 5 dias.`,\n  actFinal: \"Não pode ser desfeito: o endereço nunca mais aceitará o tipo antigo de assinatura.\",\n  actStarting: \"Começando\",\n  replaceTitle: \"Sparán: substituir esta carteira?\",\n  replaceDetail: (a) => `Este perfil do KAI já guarda a carteira ${a}. Restaurar outra a remove deste computador. Garanta que tem as 24 palavras dela antes, ou o KOIN será perdido.`,\n  revealTitle: \"Sparán: mostrar as palavras de recuperação?\",\n  revealDetail: \"Quem vir estas 24 palavras pode levar tudo o que há nesta carteira. Verifique se ninguém vê sua tela e se você não a está compartilhando.\",\n  removeTitle: \"Sparán: remover esta carteira deste computador?\",\n  removeDetail: (a) => `A carteira ${a} é apagada deste perfil do KAI. O KOIN continua no blockchain, e só as 24 palavras podem recuperá-lo. Sem elas, ele se perde para sempre.`,\n  shareTitle: \"Sparán: deixar outros plugins usarem esta carteira?\",\n  shareDetail: \"Outros plugins instalados no KAI poderão ver o endereço e o saldo desta carteira e pedir pagamentos. Você aprova cada pagamento, numa caixa de diálogo que mostra o plugin que pediu.\",\n};\n\nconst fr = {\n  noWallet: \"Pas encore de portefeuille. Créez-en un ou restaurez-le avec ses 24 mots.\",\n  noSecureStorage: \"Cet ordinateur ne peut pas chiffrer correctement la clé du portefeuille (pas de coffre de secrets du système, ou le mode texte clair de Linux), donc Sparán n'en gardera pas ici.\",\n  approvalBusy: \"Une autre validation Sparán est déjà ouverte dans KAI. Terminez-la d'abord.\",\n  justDeclined: \"Vous venez de refuser. Attendez un instant avant de réessayer.\",\n  notApproved: \"Non validé. Rien n'a été envoyé ni modifié. (Les validations demandent la fenêtre KAI ouverte et visible.)\",\n  localOnly: \"KAI est en mode Local uniquement, donc Sparán ne peut pas joindre le réseau Koinos. Changez la confidentialité dans KAI pour utiliser le portefeuille.\",\n  badAddress: \"Ce n'est pas une adresse Koinos valide.\",\n  badAmount: \"Saisissez un montant supérieur à 0 avec 8 décimales au plus.\",\n  sendToSelf: \"C'est l'adresse de ce portefeuille lui-même.\",\n  confirmNewRecipient: \"Vous n'avez jamais envoyé à cette adresse. Tapez ses 6 derniers caractères pour la confirmer.\",\n  notActive: \"Ce portefeuille n'est pas encore activé, il ne peut donc pas envoyer. Activez-le d'abord.\",\n  notEnough: (have) => `Pas assez de KOIN : ce portefeuille a ${have}.`,\n  alreadyHaveWallet: \"Ce profil KAI a déjà un portefeuille. Retirez-le d'abord pour en créer un autre.\",\n  nothingPending: \"Recommencez : aucune nouvelle phrase n'attend.\",\n  wordsDontMatch: \"Ces mots ne correspondent pas à votre phrase de récupération. Vérifiez ce que vous avez noté.\",\n  badPhrase: \"Ce n'est pas une phrase de récupération valide de 24 mots.\",\n  activationRunning: \"L'activation est déjà en cours.\",\n  otherKey: \"Cette adresse est déjà enregistrée avec une autre clé post-quantique. Sparán n'y touchera pas.\",\n  needMana: (need, have) => `L'activation demande environ ${need} KOIN de mana dans le portefeuille ; il en a ${have}. Envoyez d'abord des KOIN à l'adresse. Les KOIN ne sont pas dépensés : la mana se recharge en 5 jours.`,\n  dlgTitleSend: \"Sparán : envoyer des KOIN ?\",\n  dlgTitlePlugin: (caller) => `Sparán : ${caller} demande d'envoyer des KOIN`,\n  dlgCaller: (caller) => `Le plugin « ${caller} » vous demande d'envoyer ce paiement.`,\n  dlgReason: (reason) => `Sa raison : « ${reason} »`,\n  dlgNoReason: \"Il n'a donné aucune raison.\",\n  dlgAmount: (a) => `Montant : ${a} KOIN`,\n  dlgTo: (a) => `À : ${a}`,\n  dlgFrom: (a) => `De : ${a}`,\n  dlgNetwork: (n) => `Réseau : Koinos ${n}`,\n  dlgKnown: \"Vous avez déjà envoyé à cette adresse.\",\n  dlgNew: \"Vous n'avez JAMAIS envoyé à cette adresse. Vérifiez chaque caractère.\",\n  dlgLookalike: (k) => `ATTENTION : elle ressemble à ${k}, une adresse que vous avez utilisée, mais c'en est une autre. C'est ainsi que fonctionnent les arnaques par empoisonnement d'adresse.`,\n  dlgFinal: \"Une transaction envoyée ne peut pas être annulée.\",\n  actTitle: \"Sparán : activer la protection post-quantique ?\",\n  actDetail: (a, n, need) => `Cela installe le contrat koinos-pq sur ${a} (Koinos ${n}) et enregistre la clé ML-DSA-44 de ce portefeuille. Ensuite, seule cette clé peut déplacer les KOIN de cette adresse.\\n\\nCela utilise environ ${need} KOIN de mana. Les KOIN ne sont pas dépensés : la mana se recharge en 5 jours.`,\n  actFinal: \"C'est irréversible : l'adresse n'acceptera plus jamais son ancien type de signature.\",\n  actStarting: \"Démarrage\",\n  replaceTitle: \"Sparán : remplacer ce portefeuille ?\",\n  replaceDetail: (a) => `Ce profil KAI contient déjà le portefeuille ${a}. En restaurer un autre le retire de cet ordinateur. Assurez-vous d'avoir ses 24 mots, sinon ses KOIN sont perdus.`,\n  revealTitle: \"Sparán : afficher les mots de récupération ?\",\n  revealDetail: \"Quiconque voit ces 24 mots peut prendre tout ce que contient ce portefeuille. Vérifiez que personne ne voit votre écran et que vous ne le partagez pas.\",\n  removeTitle: \"Sparán : retirer ce portefeuille de cet ordinateur ?\",\n  removeDetail: (a) => `Le portefeuille ${a} est supprimé de ce profil KAI. Ses KOIN restent sur la blockchain, et seuls ses 24 mots peuvent le récupérer. Sans eux, il est perdu pour de bon.`,\n  shareTitle: \"Sparán : laisser d'autres plugins utiliser ce portefeuille ?\",\n  shareDetail: \"Les autres plugins installés dans KAI pourront voir l'adresse et le solde de ce portefeuille, et demander des paiements. Vous validez chaque paiement vous-même, dans une fenêtre qui nomme le plugin demandeur.\",\n};\n\nconst de = {\n  noWallet: \"Noch keine Wallet. Erstellen Sie eine oder stellen Sie sie mit ihren 24 Wörtern wieder her.\",\n  noSecureStorage: \"Dieser Computer kann den Wallet-Schlüssel nicht richtig verschlüsseln (kein Geheimnisspeicher des Systems oder Linux' Klartext-Notlösung), daher hält Sparán hier keinen.\",\n  approvalBusy: \"In KAI ist schon eine andere Sparán-Bestätigung offen. Schließen Sie diese zuerst ab.\",\n  justDeclined: \"Sie haben gerade abgelehnt. Warten Sie kurz, bevor Sie es erneut versuchen.\",\n  notApproved: \"Nicht bestätigt. Nichts wurde gesendet oder geändert. (Bestätigungen brauchen das geöffnete, sichtbare KAI-Fenster.)\",\n  localOnly: \"KAI steht auf „Nur lokal“, daher erreicht Sparán das Koinos-Netz nicht. Ändern Sie den Datenschutz in KAI, um die Wallet zu nutzen.\",\n  badAddress: \"Das ist keine gültige Koinos-Adresse.\",\n  badAmount: \"Geben Sie einen Betrag über 0 mit höchstens 8 Nachkommastellen ein.\",\n  sendToSelf: \"Das ist die Adresse dieser Wallet selbst.\",\n  confirmNewRecipient: \"An diese Adresse haben Sie noch nie gesendet. Tippen Sie ihre letzten 6 Zeichen zur Bestätigung.\",\n  notActive: \"Diese Wallet ist noch nicht aktiviert und kann nicht senden. Aktivieren Sie sie zuerst.\",\n  notEnough: (have) => `Nicht genug KOIN: Diese Wallet hat ${have}.`,\n  alreadyHaveWallet: \"Dieses KAI-Profil hat schon eine Wallet. Entfernen Sie sie zuerst, um eine neue zu erstellen.\",\n  nothingPending: \"Beginnen Sie neu: Es wartet keine neue Phrase.\",\n  wordsDontMatch: \"Diese Wörter passen nicht zu Ihrer Wiederherstellungsphrase. Prüfen Sie Ihre Notiz.\",\n  badPhrase: \"Das ist keine gültige Wiederherstellungsphrase aus 24 Wörtern.\",\n  activationRunning: \"Die Aktivierung läuft bereits.\",\n  otherKey: \"Diese Adresse ist schon mit einem anderen Post-Quanten-Schlüssel registriert. Sparán rührt sie nicht an.\",\n  needMana: (need, have) => `Die Aktivierung braucht etwa ${need} KOIN Mana in der Wallet; sie hat ${have}. Senden Sie zuerst KOIN an die Adresse. Die KOIN werden nicht ausgegeben: Mana füllt sich in 5 Tagen wieder auf.`,\n  dlgTitleSend: \"Sparán: KOIN senden?\",\n  dlgTitlePlugin: (caller) => `Sparán: ${caller} möchte KOIN senden`,\n  dlgCaller: (caller) => `Das Plugin „${caller}“ bittet Sie, diese Zahlung zu senden.`,\n  dlgReason: (reason) => `Sein Grund: „${reason}“`,\n  dlgNoReason: \"Es hat keinen Grund genannt.\",\n  dlgAmount: (a) => `Betrag: ${a} KOIN`,\n  dlgTo: (a) => `An: ${a}`,\n  dlgFrom: (a) => `Von: ${a}`,\n  dlgNetwork: (n) => `Netz: Koinos ${n}`,\n  dlgKnown: \"An diese Adresse haben Sie schon gesendet.\",\n  dlgNew: \"An diese Adresse haben Sie NOCH NIE gesendet. Prüfen Sie jedes Zeichen.\",\n  dlgLookalike: (k) => `ACHTUNG: Sie sieht aus wie ${k}, eine Adresse, die Sie benutzt haben, ist aber eine andere. So funktionieren Address-Poisoning-Betrügereien.`,\n  dlgFinal: \"Eine gesendete Transaktion lässt sich nicht rückgängig machen.\",\n  actTitle: \"Sparán: Post-Quanten-Schutz aktivieren?\",\n  actDetail: (a, n, need) => `Dies installiert den koinos-pq-Vertrag auf ${a} (Koinos ${n}) und registriert den ML-DSA-44-Schlüssel dieser Wallet. Danach kann nur dieser Schlüssel die KOIN dieser Adresse bewegen.\\n\\nEs verbraucht etwa ${need} KOIN Mana. Die KOIN werden nicht ausgegeben: Mana füllt sich in 5 Tagen wieder auf.`,\n  actFinal: \"Das lässt sich nicht rückgängig machen: Die Adresse nimmt ihre alte Art von Signatur nie wieder an.\",\n  actStarting: \"Startet\",\n  replaceTitle: \"Sparán: Diese Wallet ersetzen?\",\n  replaceDetail: (a) => `Dieses KAI-Profil enthält schon die Wallet ${a}. Wenn Sie eine andere wiederherstellen, wird sie von diesem Computer entfernt. Sorgen Sie dafür, dass Sie ihre 24 Wörter haben, sonst sind ihre KOIN verloren.`,\n  revealTitle: \"Sparán: Wiederherstellungswörter anzeigen?\",\n  revealDetail: \"Wer diese 24 Wörter sieht, kann alles aus dieser Wallet nehmen. Prüfen Sie, dass niemand Ihren Bildschirm sieht und Sie ihn nicht teilen.\",\n  removeTitle: \"Sparán: Diese Wallet von diesem Computer entfernen?\",\n  removeDetail: (a) => `Die Wallet ${a} wird aus diesem KAI-Profil gelöscht. Ihre KOIN bleiben auf der Blockchain, und nur ihre 24 Wörter holen sie zurück. Ohne sie ist sie für immer verloren.`,\n  shareTitle: \"Sparán: Anderen Plugins diese Wallet erlauben?\",\n  shareDetail: \"Andere in KAI installierte Plugins können dann Adresse und Guthaben dieser Wallet sehen und Zahlungen anfragen. Sie bestätigen jede Zahlung selbst, in einem Dialog, der das anfragende Plugin nennt.\",\n};\n\nconst catalogs = { en, es, \"pt-BR\": ptBR, fr, de };\n\n/** The messages for `language`, each key falling back to English. */\nfunction messages(language) {\n  const c = catalogs[language] || en;\n  return new Proxy(c, { get: (t, k) => (k in t ? t[k] : en[k]) });\n}\n\nmodule.exports = { messages, catalogs };\n","service/rpc.js":"\"use strict\";\n// Koinos JSON-RPC through KAI's network broker.\n//\n// koinos-pq-core's Chain uses koilib's Provider, which would call fetch() itself. Inside KAI a\n// plugin must not reach the network on its own: api.network.fetch is public-HTTPS only, checks\n// DNS, refuses redirects and is switched off by Local-Only. So each Chain's provider.call is\n// replaced with one that goes through the broker, and the bundled cross-fetch is a stub that\n// refuses (scripts/bundle.js), so nothing can bypass this by accident.\n//\n// Errors keep koilib's shape (a JSON string of {error, ...data}) because koinos-pq-core matches\n// on their text, e.g. \"insufficient pending account resources\" while a mana hold clears.\n\n// api.koinos.io intermittently answers \"AMQP connection is not open\"; koinosblocks.com serves\n// the same chain. Checked from KoinosProof on Railway, 2026-11-04.\nconst RPC = {\n  mainnet: [\"https://api.koinos.io/jsonrpc\", \"https://api.koinosblocks.com/jsonrpc\"],\n  testnet: [\"https://testnet.koinosfoundation.org/jsonrpc\"],\n};\n\nconst NODE_TROUBLE = /AMQP|internal server error|bad gateway|service unavailable|gateway time-?out|ECONN|ETIMEDOUT|socket hang up|fetch failed|not valid JSON|Unexpected token/i;\n\nclass LocalOnlyError extends Error {\n  constructor() {\n    super(\"KAI is set to Local-Only, so Sparán can't reach the Koinos network. Change privacy in KAI to use the wallet.\");\n    this.code = \"LOCAL_ONLY\";\n  }\n}\n\nfunction makeRpc(api, nodes, { timeoutMs = 30_000 } = {}) {\n  let current = 0;\n  let id = 0;\n\n  async function once(url, method, params, signal) {\n    const timer = AbortSignal.timeout(timeoutMs);\n    const combined = signal ? AbortSignal.any([signal, timer, api.signal]) : AbortSignal.any([timer, api.signal]);\n    const res = await api.network.fetch(url, {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ jsonrpc: \"2.0\", id: ++id, method, params }),\n      signal: combined,\n    });\n    const text = await res.text(); // always consume the body so KAI's request tracking can finish\n    if (!res.ok && !text.trim().startsWith(\"{\")) throw new Error(`node answered HTTP ${res.status}`);\n    let json;\n    try { json = JSON.parse(text); } catch { throw new Error(`node sent a reply that is not valid JSON (HTTP ${res.status})`); }\n    if (json.result !== undefined) return json.result;\n    if (!json.error) throw new Error(\"undefined error\");\n    const { message, data } = json.error;\n    if (!data) throw new Error(message);\n    let extra;\n    try { extra = JSON.parse(data); } catch { extra = { data }; }\n    throw new Error(JSON.stringify({ ...(message && { error: message }), ...extra }));\n  }\n\n  return async function call(method, params, signal) {\n    if (api.network.status().privacyMode === \"local-only\") throw new LocalOnlyError();\n    let last;\n    for (let i = 0; i < nodes.length; i++) {\n      const at = (current + i) % nodes.length;\n      try {\n        const result = await once(nodes[at], method, params, signal);\n        current = at;\n        return result;\n      } catch (e) {\n        last = e;\n        if (signal?.aborted || api.signal.aborted) throw e;\n        // A real answer from the chain (a refused transaction, a missing contract) is the same\n        // on every node; only trouble with the node itself moves on to the next one.\n        if (!NODE_TROUBLE.test(String(e && e.message))) throw e;\n        api.log(\"warn\", `Koinos node ${new URL(nodes[at]).host} failed (${String(e.message).slice(0, 80)}); trying the next one`);\n      }\n    }\n    throw last;\n  };\n}\n\n/** A koinos-pq-core Chain for `network` whose every request goes through api.network.fetch. */\nfunction makeChain(core, api, network) {\n  const net = core.NETWORKS[network];\n  if (!net || !RPC[network]) throw new Error(`unknown network ${network}`);\n  const nodes = RPC[network];\n  const chain = new core.Chain({ ...net, rpc: nodes });\n  const call = makeRpc(api, nodes);\n  chain.provider.call = (method, params) => call(method, params);\n  return chain;\n}\n\nmodule.exports = { makeChain, makeRpc, LocalOnlyError, RPC };\n","service/vendor/pq-core.cjs":"var __create = Object.create;\nvar __defProp = Object.defineProperty;\nvar __getOwnPropDesc = Object.getOwnPropertyDescriptor;\nvar __getOwnPropNames = Object.getOwnPropertyNames;\nvar __getProtoOf = Object.getPrototypeOf;\nvar __hasOwnProp = Object.prototype.hasOwnProperty;\nvar __commonJS = (cb, mod) => function __require() {\n  return mod || (0, cb[__getOwnPropNames(cb)[0]])((mod = { exports: {} }).exports, mod), mod.exports;\n};\nvar __export = (target, all) => {\n  for (var name in all)\n    __defProp(target, name, { get: all[name], enumerable: true });\n};\nvar __copyProp